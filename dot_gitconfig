[user]
	email = me@abc.org
	name = me
[pager]
  diff = delta
  show = delta
  log = delta
  reflog = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = true
  navigate = true  # use n and N to move between diff sections
  dark = true
[credential]
	helper = cache
[init]
	defaultBranch = master
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
